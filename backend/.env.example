# Copy to backend/.env. Never commit backend/.env or share its contents.
# Leave DATABASE_URL blank to use the local SQLite development database.
# For your existing Neon PostgreSQL database, preserve your current DATABASE_URL.
DATABASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local AI analysis (requires Ollama and the llama3 model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Prometheus (requires the port-forward described in README)
PROMETHEUS_URL=http://127.0.0.1:9090

# AWS resource inventory scan (read-only). Prefer AWS_PROFILE / aws configure.
AWS_DEFAULT_REGION=ap-south-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Only enable Chaos Mesh when the backend is connected to your disposable Minikube cluster.
CHAOS_ENABLED=false
CHAOS_EXPERIMENT_NAMESPACE=chaos-mesh

# Optional health monitor. Database-level failover only; no live traffic routing.
ENABLE_HEALTH_MONITOR=false
ENABLE_AUTOMATIC_FAILOVER=false
HEALTH_CHECK_INTERVAL_SECONDS=15
# Set after services exist, using actual database IDs, e.g. MONITORED_PAIRS=3:4
MONITORED_PAIRS=
